# ================================================================
# LoadLink AI Android Release Signing Template (keystore.properties.example)
# Copy this file to keystore.properties and replace with actual credentials.
# NEVER commit keystore.properties or private *.jks files to version control.
# ================================================================

storeFile=keystore/loadlink-signing.jks
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=loadlink-key
keyPassword=YOUR_KEY_PASSWORD_HERE
