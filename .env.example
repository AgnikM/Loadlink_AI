# ================================================================
# LoadLink AI - Root Environment Reference Template (.env.example)
# ================================================================
# This file serves as an overview for environment variables across the project.
# Copy each submodule's example file into its active `.env`:
# - backend/.env.example -> backend/.env
# - frontend/.env.example -> frontend/.env.local
# - mobile/android/keystore.properties.example -> mobile/android/keystore.properties

BACKEND_PORT=8000
FRONTEND_PORT=3000
API_URL=http://127.0.0.1:8000/api/v1
WEB_URL=http://localhost:3000
