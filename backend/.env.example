# ================================================================
# LoadLink AI - Backend Environment Configuration (.env.example)
# ================================================================

# Application Information
PROJECT_NAME="LoadLink AI"
API_V1_STR="/api/v1"

# Cryptographic & Authentication Secrets
# IMPORTANT: Generate a strong, unique secret key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite database
DATABASE_URL="sqlite+aiosqlite:///./loadlink.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql+asyncpg://loadlink_user:secure_password@localhost:5432/loadlink_prod"

# Database Connection Pool Settings (Applicable when running on PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Rate Limiting Configuration
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=30

# File Storage
UPLOAD_DIR="./uploads"

# CORS Configuration
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://10.0.2.2:3000","https://loadlink.ai","https://driver.loadlink.ai","https://admin.loadlink.ai"]
